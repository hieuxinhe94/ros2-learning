<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="second_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import second_robot urdf file -->
    <xacro:include filename="$(find second_robot)/description/robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="second_robot.ros2_control.xacro" />


    <xacro:second_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
